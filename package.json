{
  "name": "@Neurogine/catalog-product",
  "version": "1.0.0",
  "description": "Modular catalog product screen feature for React Native",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "postinstall": "npm run build",
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "yarn build",
    "typescript": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . --no-cache",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint . --fix --no-cache",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:update": "jest -u"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-transform-flow-strip-types": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30",
    "@types/lodash": "^4",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/react-native": "^0.72.0",
    "@types/react-test-renderer": "^18",
    "babel-jest": "29.7.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.6.3",
    "jest-junit": "1.1.0",
    "jest-react-native": "18.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-test-renderer": "^19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@Neurogine/core-network": "https://github.com/aaridwann/neurogine-core-network.git#master",
    "@Neurogine/ui-kit-button": "https://github.com/aaridwann/neurogine-ui-kit-button.git#d3c497658ff1bcf23298ce04d69e783c0cf4eb6b",
    "@Neurogine/ui-kit-general-text": "https://github.com/aaridwann/neurogine-ui-kit-general-text.git#d91430949c388958a685562a8d64c37d469dd542",
