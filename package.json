    "fast-memoize": "^2.5.2",
    "lodash": "^4.18.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-redux": "^9.3.0",
    "zustand": "^5.0.15"
  },
  "resolutions": {
    "@types/react": "^18.0.0"
  }
}
